{
  "name": "dsh-plugin-rpa-center",
  "version": "1.3.0",
  "type": "module",
  "description": "RPA 中心（DSH 插件）：对已登录店铺批量跑推广/订单/财务/账户余额的日常导出与采集；店铺与「账号管理」插件共用档案与登录态。",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "tools"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "rpa",
    "pinduoduo",
    "automation"
  ]
}
